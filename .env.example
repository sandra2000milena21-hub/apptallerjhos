# Copia este archivo como .env.local (en tu computador) o crea estas variables en Vercel.

# --- Obligatorias ---
# Clave larga y aleatoria para firmar las sesiones (mínimo 32 caracteres).
SESSION_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria-de-32-o-mas

# Usuario administrador que se crea la primera vez que arranca la app (después se cambia desde Ajustes).
ADMIN_EMAIL=admin@mitaller.co
ADMIN_PASSWORD=cambia-esta-clave
ADMIN_NAME=Administrador

# Dirección pública de la app (enlaces de seguimiento, QR, webhooks). Ej. https://taller.midominio.co
PUBLIC_URL=http://localhost:3000

# --- En Vercel (las crean las integraciones al conectarlas al proyecto) ---
# Base de datos Turso (Marketplace de Vercel → Turso Cloud)
# TURSO_DATABASE_URL=libsql://tu-base.turso.io
# TURSO_AUTH_TOKEN=...
# Vercel Blob privado (Storage → Blob → Private)
# BLOB_READ_WRITE_TOKEN=...

# --- Solo en tu computador ---
# Sin TURSO_DATABASE_URL ni BLOB_READ_WRITE_TOKEN la app usa un archivo local y una carpeta para las fotos.
DATA_DIR=./data

# --- Opcional ---
# Clave de Anthropic para "Llenar con IA" (también se puede poner en Ajustes → Integraciones).
# ANTHROPIC_API_KEY=
