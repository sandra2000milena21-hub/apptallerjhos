# Copia este archivo como .env (servidor VPS) o .env.local (tu computador) y llena los valores.
# NUNCA subas el archivo .env a GitHub ni lo compartas: contiene las llaves de la app.

# --- Obligatorias ---
# Clave larga y aleatoria para firmar las sesiones (mínimo 32 caracteres). En producción la app
# no arranca si falta o si se deja este texto de ejemplo. Genera una con:  openssl rand -hex 32
SESSION_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria-de-32-o-mas

# Usuario administrador que se crea la PRIMERA vez que arranca la app con la base vacía
# (después se cambia desde Ajustes → Usuarios). En un servidor público la clave debe tener 12+ caracteres.
ADMIN_EMAIL=admin@mitaller.co
ADMIN_PASSWORD=cambia-esta-clave
ADMIN_NAME=Administrador

# Dirección pública de la app (enlaces de seguimiento, QR, webhooks). Con https:// en el servidor.
PUBLIC_URL=http://localhost:3000

# --- Solo en servidor propio (VPS con docker compose) ---
# Dominio que apunta a la IP del servidor, sin https://. Debe coincidir con PUBLIC_URL.
# DOMAIN=taller.midominio.co

# --- En Vercel (las crean las integraciones al conectarlas al proyecto) ---
# Base de datos Turso (Marketplace de Vercel → Turso Cloud)
# TURSO_DATABASE_URL=libsql://tu-base.turso.io
# TURSO_AUTH_TOKEN=...
# Vercel Blob privado (Storage → Blob → Private)
# BLOB_READ_WRITE_TOKEN=...

# --- Solo en tu computador ---
# Sin TURSO_DATABASE_URL ni BLOB_READ_WRITE_TOKEN la app usa un archivo local y una carpeta para las fotos.
# (En docker compose se fija sola en /data; no hace falta ponerla.)
DATA_DIR=./data

# --- Opcional ---
# Clave de Anthropic para "Llenar con IA" (también se puede poner en Ajustes → Integraciones).
# ANTHROPIC_API_KEY=
